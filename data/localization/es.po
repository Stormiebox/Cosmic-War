# ==========data/scripts/entity/bulletinboardmissions.lua ==========
#: data/scripts/entity/bulletinboardmissions.lua:
#: data/scripts/player/missions/cw_forcerecon.lua:
msgid "War Contract: Force Recon"
msgstr "Contrato de Guerra: Reconocimiento de Fuerza"

#: data/scripts/entity/bulletinboardmissions.lua:
msgid "Tensions are rising. We need a discreet captain to scout a hostile sector and gather intel."
msgstr "Las tensiones están aumentando. Necesitamos un capitán discreto para explorar un sector hostil y recopilar información."

#: data/scripts/entity/bulletinboardmissions.lua:
msgid "This is a reconnaissance operation. Get in, gather the intel, and get out in one piece."
msgstr "Esta es una operación de reconocimiento. Entra, reúne la información y sal de una pieza."

#: data/scripts/entity/bulletinboardmissions.lua:
#: data/scripts/player/missions/cw_borderskirmish.lua:
msgid "War Contract: Border Skirmish"
msgstr "Contrato de Guerra: Escaramuza Fronteriza"

#: data/scripts/entity/bulletinboardmissions.lua:
msgid "Border disputes are getting violent. Intercept and eliminate an enemy border patrol."
msgstr "Las disputas fronterizas se están volviendo violentas. Intercepta y elimina una patrulla fronteriza enemiga."

#: data/scripts/entity/bulletinboardmissions.lua:
msgid "Take out their patrol. We need to show them we won't be intimidated."
msgstr "Elimina su patrulla. Necesitamos demostrarles que no seremos intimidados."

#: data/scripts/entity/bulletinboardmissions.lua:
#: data/scripts/player/missions/cw_resourcesabotage.lua:
msgid "War Contract: Resource Sabotage"
msgstr "Contrato de Guerra: Sabotaje de Recursos"

#: data/scripts/entity/bulletinboardmissions.lua:
msgid "A hostile mining operation is extracting resources in contested space. Put an end to it."
msgstr "Una operación minera hostil está extrayendo recursos en espacio en disputa. Ponle fin."

#: data/scripts/entity/bulletinboardmissions.lua:
msgid "Crippling their resource flow now will save our fleets later. Destroy those miners."
msgstr "Paralizar su flujo de recursos ahora salvará nuestras flotas más tarde. Destruye esos mineros."

#: data/scripts/entity/bulletinboardmissions.lua:
#: data/scripts/player/missions/cw_interception.lua:
msgid "War Contract: Interception"
msgstr "Contrato de Guerra: Intercepción"

#: data/scripts/entity/bulletinboardmissions.lua:
msgid "Conflict has intensified. Intercept hostile supply movement in nearby sectors."
msgstr "El conflicto se ha intensificado. Intercepta el movimiento de suministros hostiles en sectores cercanos."

#: data/scripts/entity/bulletinboardmissions.lua:
msgid "We need skilled captains to strike enemy supply lines immediately."
msgstr "Necesitamos capitanes habilidosos para atacar las líneas de suministro enemigas de inmediato."

#: data/scripts/entity/bulletinboardmissions.lua:
#: data/scripts/player/missions/cw_breakthrough.lua:
msgid "War Contract: Breakthrough"
msgstr "Contrato de Guerra: Avance"

#: data/scripts/entity/bulletinboardmissions.lua:
msgid "We have a critical supply convoy moving through contested space. Defend them until they can jump."
msgstr "Tenemos un convoy de suministros crítico moviéndose a través del espacio en disputa. Defiéndelos hasta que puedan saltar."

#: data/scripts/entity/bulletinboardmissions.lua:
msgid "Our convoy is vulnerable. We need a capable escort to ensure they make it."
msgstr "Nuestro convoy es vulnerable. Necesitamos un escolta capaz para asegurar que lo logren."

#: data/scripts/entity/bulletinboardmissions.lua:
#: data/scripts/player/missions/cw_frontlinesiege.lua:
msgid "War Contract: Frontline Siege"
msgstr "Contrato de Guerra: Asedio en Primera Línea"

#: data/scripts/entity/bulletinboardmissions.lua:
msgid "The enemy has established a Forward Operating Base. We need it destroyed."
msgstr "El enemigo ha establecido una Base de Operaciones Avanzada. Necesitamos que sea destruida."

#: data/scripts/entity/bulletinboardmissions.lua:
msgid "Command has authorized a strike on an enemy FOB. Are you ready to lead the assault?"
msgstr "El Mando ha autorizado un ataque a una FOB enemiga. ¿Estás listo para liderar el asalto?"

#: data/scripts/entity/bulletinboardmissions.lua:
#: data/scripts/player/missions/cw_highvaluedefection.lua:
msgid "War Contract: High-Value Extraction"
msgstr "Contrato de Guerra: Extracción de Alto Valor"

#: data/scripts/entity/bulletinboardmissions.lua:
msgid "A high-ranking enemy officer is defecting to our side. We need you to extract them safely."
msgstr "Un oficial enemigo de alto rango está desertando a nuestro lado. Necesitamos que los extraigas a salvo."

#: data/scripts/entity/bulletinboardmissions.lua:
msgid "This is a highly classified operation. Extract the defector at all costs. Expect heavy resistance."
msgstr "Esta es una operación altamente clasificada. Extrae al desertor a toda costa. Espera fuerte resistencia."

#: data/scripts/entity/bulletinboardmissions.lua:
#: data/scripts/player/missions/cw_decapitationstrike.lua:
msgid "War Contract: Decapitation Strike"
msgstr "Contrato de Guerra: Ataque de Decapitación"

#: data/scripts/entity/bulletinboardmissions.lua:
msgid "The enemy Flagship has entered the sector. This is our chance to end the war."
msgstr "La Nave Insignia enemiga ha entrado en el sector. Esta es nuestra oportunidad de terminar la guerra."

#: data/scripts/entity/bulletinboardmissions.lua:
msgid "Warning: This is a suicide mission. The enemy Flagship is heavily armed and escorted. Do not accept unless you have a fleet."
msgstr "Advertencia: Esta es una misión suicida. La Nave Insignia enemiga está fuertemente armada y escoltada. No aceptes a menos que tengas una flota."

#: data/scripts/entity/bulletinboardmissions.lua:
msgid "Extreme"
msgstr "Extremo"


# ==========data/scripts/entity/cosmicwarnews.lua ==========
#: data/scripts/entity/cosmicwarnews.lua:
#: data/scripts/server/background/cosmicwarnews.lua:
msgid "War Bulletin: ${factionA} and ${factionB} relations deteriorated to ${rel}."
msgstr "Boletín de Guerra: Las relaciones entre ${factionA} y ${factionB} se deterioraron a ${rel}."

#: data/scripts/entity/cosmicwarnews.lua:
#: data/scripts/server/background/cosmicwarnews.lua:
msgid "Conflict Watch: ${factionA} and ${factionB} are entering open hostility (${rel})."
msgstr "Alerta de Conflicto: ${factionA} y ${factionB} están entrando en hostilidad abierta (${rel})."

#: data/scripts/entity/cosmicwarnews.lua:
#: data/scripts/server/background/cosmicwarnews.lua:
msgid "Strategic Alert: tensions between ${factionA} and ${factionB} reached ${rel}."
msgstr "Alerta Estratégica: las tensiones entre ${factionA} y ${factionB} alcanzaron ${rel}."

#: data/scripts/entity/cosmicwarnews.lua:
msgid "Cosmic War"
msgstr "Guerra Cósmica"

# ==========data/scripts/events/cw_armsdeal.lua ==========
#: data/scripts/events/cw_armsdeal.lua:
msgid "Covert Operative"
msgstr "Operativo Encubierto"

#: data/scripts/events/cw_armsdeal.lua:
msgid "Black Market Dealer"
msgstr "Traficante del Mercado Negro"

#: data/scripts/events/cw_armsdeal.lua:
msgid "We have company! The arms deal is compromised! Eradicate all witnesses!"
msgstr "¡Tenemos compañía! ¡El trato de armas está comprometido! ¡Erradica a todos los testigos!"

# ==========data/scripts/player/missions/cw_borderskirmish.lua ==========
#: data/scripts/player/missions/cw_borderskirmish.lua:
#: data/scripts/player/missions/cw_breakthrough.lua:
#: data/scripts/player/missions/cw_decapitationstrike.lua:
#: data/scripts/player/missions/cw_forcerecon.lua:
#: data/scripts/player/missions/cw_frontlinesiege.lua:
#: data/scripts/player/missions/cw_highvaluedefection.lua:
#: data/scripts/player/missions/cw_interception.lua:
#: data/scripts/player/missions/cw_resourcesabotage.lua:
msgid "hostiles"
msgstr "hostiles"

#: data/scripts/player/missions/cw_borderskirmish.lua:
msgid "You accepted a skirmish contract from ${giver}."
msgstr "Has aceptado un contrato de escaramuza de ${giver}."

#: data/scripts/player/missions/cw_borderskirmish.lua:
msgid "Intercept and eliminate the border patrol belonging to ${enemy}."
msgstr "Intercepta y elimina la patrulla fronteriza perteneciente a ${enemy}."

#: data/scripts/player/missions/cw_borderskirmish.lua:
#: data/scripts/player/missions/cw_forcerecon.lua:
#: data/scripts/player/missions/cw_interception.lua:
#: data/scripts/player/missions/cw_resourcesabotage.lua:
msgid "Head to sector (${location.x}:${location.y})"
msgstr "Dirígete al sector (${location.x}:${location.y})"

#: data/scripts/player/missions/cw_borderskirmish.lua:
msgid "Destroy the patrol"
msgstr "Destruye la patrulla"

#: data/scripts/player/missions/cw_borderskirmish.lua:
msgid "Patrol eliminated. We will not be intimidated on our own borders. Payment transferred."
msgstr "Patrulla eliminada. No seremos intimidados en nuestras propias fronteras. Pago transferido."

# ==========data/scripts/player/missions/cw_breakthrough.lua ==========
#: data/scripts/player/missions/cw_breakthrough.lua:
msgid "You accepted an escort contract from ${giver}."
msgstr "Has aceptado un contrato de escolta de ${giver}."

#: data/scripts/player/missions/cw_breakthrough.lua:
msgid "Defend their supply convoy from ${enemy} interceptors."
msgstr "Defiende su convoy de suministros de los interceptores de ${enemy}."

#: data/scripts/player/missions/cw_breakthrough.lua:
#: data/scripts/player/missions/cw_decapitationstrike.lua:
#: data/scripts/player/missions/cw_frontlinesiege.lua:
msgid "Jump to sector (${location.x}:${location.y})"
msgstr "Salta al sector (${location.x}:${location.y})"

#: data/scripts/player/missions/cw_breakthrough.lua:
msgid "Protect the convoy until they jump"
msgstr "Protege el convoy hasta que salte"

#: data/scripts/player/missions/cw_breakthrough.lua:
msgid "Convoy has escaped. Contract payment transferred."
msgstr "El convoy ha escapado. Pago del contrato transferido."

#: data/scripts/player/missions/cw_breakthrough.lua:
msgid "We are charging our hyperdrives. Hold them off until we can jump!"
msgstr "Estamos cargando nuestros hiperimpulsores. ¡Mantenlos a raya hasta que podamos saltar!"

#: data/scripts/player/missions/cw_breakthrough.lua:
msgid "The convoy was completely destroyed! We are withdrawing your contract!"
msgstr "¡El convoy fue completamente destruido! ¡Retiramos tu contrato!"

#: data/scripts/player/missions/cw_breakthrough.lua:
msgid "Target acquired! Destroy the convoy!"
msgstr "¡Objetivo fijado! ¡Destruye el convoy!"

#: data/scripts/player/missions/cw_breakthrough.lua:
msgid "All ships safely away! Excellent work, commander. We've added a bonus to your payment."
msgstr "¡Todas las naves a salvo! Excelente trabajo, comandante. Hemos añadido una bonificación a tu pago."

#: data/scripts/player/missions/cw_breakthrough.lua:
msgid "We took losses, but the convoy is away. Sending payment now."
msgstr "Sufrimos pérdidas, pero el convoy está a salvo. Enviando el pago ahora."

# ==========data/scripts/player/missions/cw_decapitationstrike.lua ==========
#: data/scripts/player/missions/cw_decapitationstrike.lua:
msgid "You accepted a Decapitation Strike contract from ${giver}."
msgstr "Has aceptado un contrato de Ataque de Decapitación de ${giver}."

#: data/scripts/player/missions/cw_decapitationstrike.lua:
msgid "${enemy} has deployed their Flagship to the frontline. Destroy it to end this war."
msgstr "${enemy} ha desplegado su Nave Insignia en el frente. Destrúyela para terminar esta guerra."

#: data/scripts/player/missions/cw_decapitationstrike.lua:
msgid "Destroy the Enemy Flagship"
msgstr "Destruye la Nave Insignia Enemiga"

#: data/scripts/player/missions/cw_decapitationstrike.lua:
msgid "The enemy Flagship is destroyed! Their fleet is completely broken! We are suing for peace immediately."
msgstr "¡La Nave Insignia enemiga está destruida! ¡Su flota está completamente rota! Estamos pidiendo la paz inmediatamente."

#: data/scripts/player/missions/cw_decapitationstrike.lua:
msgid "You dare challenge our Dreadnought? We will crush you and your cowardly employers!"
msgstr "¿Te atreves a desafiar a nuestro Acorazado? ¡Te aplastaremos a ti y a tus cobardes empleadores!"

#: data/scripts/player/missions/cw_decapitationstrike.lua:
msgid "Flagship Dreadnought"
msgstr "Acorazado Insignia"

# ==========data/scripts/events/cw_diplomaticsabotage.lua ==========
#: data/scripts/events/cw_diplomaticsabotage.lua:
msgid "Diplomatic Envoy"
msgstr "Enviado Diplomático"

#: data/scripts/events/cw_diplomaticsabotage.lua:
msgid "Mayday! This is a diplomatic peace envoy! Extremists are trying to sabotage the ceasefire talks! We need immediate assistance!"
msgstr "¡Mayday! ¡Este es un enviado diplomático de paz! ¡Los extremistas están intentando sabotear las conversaciones de alto el fuego! ¡Necesitamos asistencia inmediata!"

#: data/scripts/events/cw_diplomaticsabotage.lua:
msgid "Hardliner Extremist"
msgstr "Extremista de Línea Dura"

#: data/scripts/events/cw_diplomaticsabotage.lua:
msgid "Thank you! With those extremists gone, we can proceed to the peace summit. We owe you our lives."
msgstr "¡Gracias! Con esos extremistas desaparecidos, podemos proceder a la cumbre de paz. Les debemos nuestras vidas."

# ==========data/scripts/events/cw_fleetclash.lua ==========
#: data/scripts/events/cw_fleetclash.lua:
msgid "Warning! Massive hostile fleet signature detected dropping out of hyperspace! All vessels to battle stations!"
msgstr "¡Advertencia! ¡Se ha detectado una firma de una enorme flota hostil saliendo del hiperespacio! ¡Todas las naves a sus puestos de combate!"

# ==========data/scripts/player/missions/cw_forcerecon.lua ==========
#: data/scripts/player/missions/cw_forcerecon.lua:
msgid "You accepted a Force Recon contract from ${giver}."
msgstr "Has aceptado un contrato de Reconocimiento de Fuerza de ${giver}."

#: data/scripts/player/missions/cw_forcerecon.lua:
msgid "Locate and scan the Covert Listening Post belonging to ${enemy}."
msgstr "Localiza y escanea el Puesto de Escucha Encubierto perteneciente a ${enemy}."

#: data/scripts/player/missions/cw_forcerecon.lua:
msgid "Stay within 6km of the Listening Post until the scan completes"
msgstr "Mantente a menos de 6km del Puesto de Escucha hasta que se complete el escaneo"

#: data/scripts/player/missions/cw_forcerecon.lua:
msgid "Data received loud and clear. Good work out there, captain. Payment transferred."
msgstr "Datos recibidos fuerte y claro. Buen trabajo ahí fuera, capitán. Pago transferido."

#: data/scripts/player/missions/cw_forcerecon.lua:
msgid "The Listening Post was destroyed before we could extract the intel! The contract is void."
msgstr "¡El Puesto de Escucha fue destruido antes de que pudiéramos extraer la información! El contrato es nulo."

#: data/scripts/player/missions/cw_forcerecon.lua:
msgid "You are in range. Establishing data link... Stay close!"
msgstr "Estás en rango. Estableciendo enlace de datos... ¡Mantente cerca!"

#: data/scripts/player/missions/cw_forcerecon.lua:
msgid "Data link lost! You are too far away from the station!"
msgstr "¡Enlace de datos perdido! ¡Estás demasiado lejos de la estación!"

#: data/scripts/player/missions/cw_forcerecon.lua:
msgid "Covert Listening Post"
msgstr "Puesto de Escucha Encubierto"

# ==========data/scripts/player/missions/cw_frontlinesiege.lua ==========
#: data/scripts/player/missions/cw_frontlinesiege.lua:
msgid "You accepted a siege contract from ${giver}."
msgstr "Has aceptado un contrato de asedio de ${giver}."

#: data/scripts/player/missions/cw_frontlinesiege.lua:
msgid "${enemy} has established a Forward Operating Base (FOB) in a nearby sector."
msgstr "${enemy} ha establecido una Base de Operaciones Avanzada (FOB) en un sector cercano."

#: data/scripts/player/missions/cw_frontlinesiege.lua:
msgid "Destroy the Forward Operating Base"
msgstr "Destruye la Base de Operaciones Avanzada"

#: data/scripts/player/missions/cw_frontlinesiege.lua:
msgid "Target destroyed. Excellent work, commander. Payment transferred."
msgstr "Objetivo destruido. Excelente trabajo, comandante. Pago transferido."

#: data/scripts/player/missions/cw_frontlinesiege.lua:
msgid "We are under attack! Scramble all defenders!"
msgstr "¡Estamos bajo ataque! ¡Movilicen a todos los defensores!"

#: data/scripts/player/missions/cw_frontlinesiege.lua:
msgid "Forward Operating Base"
msgstr "Base de Operaciones Avanzada"

#: data/scripts/player/missions/cw_frontlinesiege.lua:
msgid "Reinforcements have arrived! Destroy the attackers!"
msgstr "¡Han llegado refuerzos! ¡Destruyan a los atacantes!"

# ==========data/scripts/player/missions/cw_highvaluedefection.lua ==========
#: data/scripts/player/missions/cw_highvaluedefection.lua:
msgid "You accepted a classified extraction contract from ${giver}."
msgstr "Has aceptado un contrato de extracción clasificada de ${giver}."

#: data/scripts/player/missions/cw_highvaluedefection.lua:
msgid "A high-ranking officer from ${enemy} is attempting to defect."
msgstr "Un oficial de alto rango de ${enemy} está intentando desertar."

#: data/scripts/player/missions/cw_highvaluedefection.lua:
msgid "Rendezvous at sector (${location.x}:${location.y})"
msgstr "Reúnete en el sector (${location.x}:${location.y})"

#: data/scripts/player/missions/cw_highvaluedefection.lua:
msgid "Protect the defector until their hyperdrive charges"
msgstr "Protege al desertor hasta que se cargue su hiperimpulsor"

#: data/scripts/player/missions/cw_highvaluedefection.lua:
msgid "Target secured. You have struck a massive blow to the enemy command structure. Payment transferred."
msgstr "Objetivo asegurado. Has asestado un golpe masivo a la estructura de mando enemiga. Pago transferido."

#: data/scripts/player/missions/cw_highvaluedefection.lua:
msgid "Thank goodness you arrived. My hyperdrive is damaged and needs 3 minutes to spool up. Don't let them take me!"
msgstr "Menos mal que llegaste. Mi hiperimpulsor está dañado y necesita 3 minutos para acelerar. ¡No dejes que me lleven!"

#: data/scripts/player/missions/cw_highvaluedefection.lua:
msgid "The defector's signal was lost... The mission is a failure."
msgstr "La señal del desertor se perdió... La misión es un fracaso."

#: data/scripts/player/missions/cw_highvaluedefection.lua:
msgid "Hold them off! Hyperdrive is at 60 seconds!"
msgstr "¡Mantenlos a raya! ¡El hiperimpulsor está a 60 segundos!"

#: data/scripts/player/missions/cw_highvaluedefection.lua:
msgid "Defecting Officer"
msgstr "Oficial Desertor"

#: data/scripts/player/missions/cw_highvaluedefection.lua:
msgid "There is the traitor! Execute them immediately!"
msgstr "¡Ahí está el traidor! ¡Ejecútenlo inmediatamente!"

# ==========data/scripts/player/missions/cw_interception.lua ==========
#: data/scripts/player/missions/cw_interception.lua:
msgid "You accepted a war contract from ${giver}."
msgstr "Has aceptado un contrato de guerra de ${giver}."

#: data/scripts/player/missions/cw_interception.lua:
msgid "Intercept and destroy the supply convoy belonging to ${enemy}."
msgstr "Intercepta y destruye el convoy de suministros perteneciente a ${enemy}."

#: data/scripts/player/missions/cw_interception.lua:
msgid "Destroy the convoy"
msgstr "Destruye el convoy"

#: data/scripts/player/missions/cw_interception.lua:
msgid "Target destroyed. Contract payment transferred."
msgstr "Objetivo destruido. Pago del contrato transferido."

#: data/scripts/player/missions/cw_interception.lua:
msgid "We're tracking the convoy on your sensors. Take them out!"
msgstr "Estamos rastreando el convoy en tus sensores. ¡Elimínalos!"

# ==========data/scripts/events/cw_refugeeconvoy.lua ==========
#: data/scripts/events/cw_refugeeconvoy.lua:
msgid "Mayday, mayday! This is a civilian refugee convoy! We are being tracked by a hunter fleet! Anyone in the sector, please help us until our hyperdrives are charged!"
msgstr "¡Mayday, mayday! ¡Este es un convoy de refugiados civiles! ¡Estamos siendo rastreados por una flota cazadora! ¡Cualquiera en el sector, por favor ayúdennos hasta que nuestros hiperimpulsores estén cargados!"

#: data/scripts/events/cw_refugeeconvoy.lua:
msgid "Target acquired. Leave no survivors."
msgstr "Objetivo fijado. No dejen supervivientes."

#: data/scripts/events/cw_refugeeconvoy.lua:
msgid "Thank you! Our drives are charged and we are jumping to safety. We won't forget this!"
msgstr "¡Gracias! Nuestros motores están cargados y estamos saltando a un lugar seguro. ¡No olvidaremos esto!"

# ==========data/scripts/player/missions/cw_resourcesabotage.lua ==========
#: data/scripts/player/missions/cw_resourcesabotage.lua:
msgid "You accepted a sabotage contract from ${giver}."
msgstr "Has aceptado un contrato de sabotaje de ${giver}."

#: data/scripts/player/missions/cw_resourcesabotage.lua:
msgid "A mining fleet from ${enemy} has set up an extraction operation. Wipe them out."
msgstr "Una flota minera de ${enemy} ha establecido una operación de extracción. Aniquílalos."

#: data/scripts/player/missions/cw_resourcesabotage.lua:
msgid "Destroy the mining operation"
msgstr "Destruye la operación minera"

#: data/scripts/player/missions/cw_resourcesabotage.lua:
msgid "Mining operation destroyed. That will surely put a dent in their supply lines. Payment transferred."
msgstr "Operación minera destruida. Eso seguramente hará mella en sus líneas de suministro. Pago transferido."

# ==========data/scripts/events/cw_strandedflagship.lua ==========
#: data/scripts/events/cw_strandedflagship.lua:
msgid "Stranded Flagship"
msgstr "Nave Insignia Varada"

#: data/scripts/events/cw_strandedflagship.lua:
msgid "Ship Computer"
msgstr "Computadora de la Nave"

#: data/scripts/entity/cw_strandedflagship.lua:
#: data/scripts/events/cw_strandedflagship.lua:
msgid "Warning: Massive structural damage detected on an adrift Dreadnought. Its engines appear offline."
msgstr "Advertencia: Daño estructural masivo detectado en un Acorazado a la deriva. Sus motores parecen estar desconectados."

#: data/scripts/events/cw_strandedflagship.lua:
msgid "This is the repair fleet! We have arrived at the Flagship's location. Hostiles detected! Engage immediately!"
msgstr "¡Esta es la flota de reparación! Hemos llegado a la ubicación de la Nave Insignia. ¡Hostiles detectados! ¡Atacar inmediatamente!"
